server {
    listen 80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 404;
    }
}

server {
    listen ${ADMIN_BIND}:8443 ssl;
    server_name ${ADMIN_HOST};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:3744;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}

server {
    listen 127.0.0.1:9443 ssl;
    server_name ${PUBLIC_HOST};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /events {
        proxy_pass http://127.0.0.1:7447;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /upload {
        proxy_pass http://127.0.0.1:3742;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        client_max_body_size 256m;
        client_body_buffer_size 16m;
        proxy_read_timeout 300s;
    }

    location = /mirror {
        proxy_pass http://127.0.0.1:3742;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        client_max_body_size 256m;
        client_body_buffer_size 16m;
        proxy_read_timeout 300s;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:3742;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 10s;
    }

    location ~ ^/list/ {
        proxy_pass http://127.0.0.1:3742;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    location ~ "^/[0-9a-f]{64}(?:\\.[A-Za-z0-9]{1,16})?$" {
        proxy_pass http://127.0.0.1:3742;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
    }

    location = /v1/pairings/claim { include /etc/nginx/proxy_params; }
    location = /v1/pairings/remove-self { include /etc/nginx/proxy_params; }
    location = /v1/grants { include /etc/nginx/proxy_params; }
    location = /v1/grants/remove { include /etc/nginx/proxy_params; }
    location = /v1/grants/devices { include /etc/nginx/proxy_params; }
    location = /v1/grants/vouch { include /etc/nginx/proxy_params; }
    location = /v1/credentials { include /etc/nginx/proxy_params; }
    location = /v1/peers { include /etc/nginx/proxy_params; }

    location / {
        return 404;
    }
}
