#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
COMPOSE="docker compose --env-file .env"

need_config() {
    if [ ! -f .env ]; then
        echo "Copy .env.example to .env and set the operator values first." >&2
        exit 1
    fi
}

need_state() {
    need_config
    if [ ! -s state/spry-turn-secret ] || [ ! -s state/tls/fullchain.pem ] || [ ! -s state/tls/privkey.pem ] || [ ! -s state/tls/turn-fullchain.pem ] || [ ! -s state/tls/turn-privkey.pem ]; then
        echo "Run $0 init first." >&2
        exit 1
    fi
}

sync_certs() {
    if [ "$(id -u)" = 0 ]; then
        "$ROOT/caddy/sync-certs.sh"
    else
        sudo "$ROOT/caddy/sync-certs.sh"
    fi
}

case "${1:-}" in
    setup|verify)
        command=$1
        shift
        exec python3 "$ROOT/bin/setup.py" "$command" "$@"
        ;;
    init)
        need_config
        set -a
        . ./.env
        set +a
        case "$OWNER_KEYS" in
            *[!0-9a-fA-F,]* | *replace-*)
                echo "OWNER_KEYS must contain hex public keys, separated by commas." >&2
                exit 1
                ;;
        esac
        case "$PUBLIC_HOST" in
            *.* | localhost) ;;
            *) echo "PUBLIC_HOST must be a DNS name clients can resolve." >&2; exit 1 ;;
        esac
        if [ "$PUBLIC_IP" = "203.0.113.10" ]; then
            echo "Set PUBLIC_IP to this host's actual public IPv4 address." >&2
            exit 1
        fi
        umask 077
        mkdir -p state/tls state/letsencrypt state/certbot-work state/certbot-log
        python3 "$ROOT/bin/wok-config.py" "$PUBLIC_HOST" "$OWNER_KEYS" > state/wokd.toml
        chmod 644 state/wokd.toml
        if [ ! -s state/spry-turn-secret ]; then
            openssl rand -hex 32 > state/spry-turn-secret
        fi
        chmod 644 state/spry-turn-secret
        if [ ! -s state/tls/fullchain.pem ]; then
            openssl req -x509 -newkey rsa:3072 -nodes -days 2 \
                -keyout state/tls/privkey.pem \
                -out state/tls/fullchain.pem \
                -subj "/CN=$PUBLIC_HOST" \
                -addext "subjectAltName=DNS:$PUBLIC_HOST,DNS:turn.$PUBLIC_HOST,DNS:$ADMIN_HOST"
            chmod 644 state/tls/privkey.pem
            chmod 644 state/tls/fullchain.pem
            echo "Created a two-day bootstrap certificate. Run $0 certify before inviting users."
        fi
        if [ ! -s state/tls/turn-fullchain.pem ]; then
            cp state/tls/fullchain.pem state/tls/turn-fullchain.pem
            cp state/tls/privkey.pem state/tls/turn-privkey.pem
            chmod 644 state/tls/turn-fullchain.pem
            chmod 644 state/tls/turn-privkey.pem
        fi
        chmod 644 state/tls/privkey.pem state/tls/turn-privkey.pem
        $COMPOSE config --quiet
        echo "Initialised private state in $ROOT/state."
        ;;
    up)
        need_state
        $COMPOSE up -d --wait
        ;;
    down)
        need_config
        $COMPOSE down
        ;;
    status)
        need_config
        $COMPOSE ps
        ;;
    restart)
        need_state
        $COMPOSE restart spry gateway
        ;;
    sync-certs)
        need_state
        sync_certs
        ;;
    certify)
        need_state
        set -a
        . ./.env
        set +a
        if [ "${SHARED_PROXY:-false}" = "true" ]; then
            sync_certs
        else
            $COMPOSE run --rm certbot certonly --webroot -w /var/www/certbot \
                -d "$PUBLIC_HOST" -d "turn.$PUBLIC_HOST" -d "$ADMIN_HOST" \
                --agree-tos --email "$ACME_EMAIL" --non-interactive
            $COMPOSE restart spry gateway
        fi
        ;;
    renew)
        need_state
        set -a
        . ./.env
        set +a
        if [ "${SHARED_PROXY:-false}" = "true" ]; then
            sync_certs
        else
            $COMPOSE run --rm certbot renew --webroot -w /var/www/certbot --non-interactive
            $COMPOSE restart spry gateway
        fi
        ;;
    backup)
        need_config
        . "$ROOT/bin/backup.sh"
        backup_create
        ;;
    restore)
        need_config
        . "$ROOT/bin/backup.sh"
        backup_restore "${2:-}"
        ;;
    *)
        echo "Usage: $0 {setup|verify|init|up|down|status|restart|certify|sync-certs|renew|backup|restore}" >&2
        exit 2
        ;;
esac
